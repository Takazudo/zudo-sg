{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Snapshot of @takazudo/zudo-doc@9.0.0 tsconfig.base.json
  // (82049856397927077c5288465db34e44d0939260; blob f052aebac2b57fd447455490f6d2122a0ba372e4, unchanged since 6.2.0).
  // Upstream now omits baseUrl too; compiler-option reconciliation is a no-op.
  // baseUrl is omitted: TypeScript 7 removes it, and baseUrl:null does not clear zfb's inherited value.
  // Reconciliation: ZUDO_DEPS_PINS.md "TypeScript compiler configuration".
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@takazudo/zfb/zudo-react",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "files": [
    "./node_modules/@takazudo/zudo-doc/zfb-config-shim.d.ts",
    "./node_modules/@takazudo/zudo-doc/virtual-modules.d.ts"
  ],
  "exclude": ["dist", "e2e/fixtures", "fixtures", "apps", "packages", "doc", "pages", "worktrees", "vendor", "_temp-resource", "src/**/__tests__", "scripts/**/__tests__", "vitest.config.ts"]
}
