{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Snapshot of @takazudo/zudo-doc@6.0.0 packages/zudo-doc/tsconfig.base.json
  // (b4f974598b27064a092eeadb5b2e5559078a8bb9). 6.1.1 publishes the same blob
  // (6c863a3ae09e10c187742b8f1461f061ce789adb); reconciliation is a no-op.
  // baseUrl is omitted: TypeScript 7 removes it, and baseUrl:null does not clear zfb's inherited value.
  // Reconciliation: ZUDO_DEPS_PINS.md "TypeScript compiler configuration".
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@takazudo/zfb/zudo-react",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "files": [
    "./node_modules/@takazudo/zudo-doc/zfb-config-shim.d.ts",
    "./node_modules/@takazudo/zudo-doc/virtual-modules.d.ts"
  ],
  "exclude": ["dist", "e2e/fixtures", "fixtures", "apps", "packages", "doc", "pages", "worktrees", "vendor", "_temp-resource", "src/**/__tests__", "scripts/**/__tests__", "vitest.config.ts"]
}
