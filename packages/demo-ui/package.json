    "@types/node": "^22.0.0",
    "happy-dom": "20.14.6",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.0",
    "vite": "7.3.5",
    "vitest": "4.1.11",
    "postcss": "^8.5.28"
