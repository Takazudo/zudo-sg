    "preact": "^10.29.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.0.0",
    "happy-dom": "^16.8.1",
    "jsdom": "^29.1.1",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  }
