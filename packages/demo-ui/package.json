{
  "name": "@zudo-sg/demo-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/colors.css": "./styles/colors.css",
    "./src/*": "./src/*"
  },
  "scripts": {
