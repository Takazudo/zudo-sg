{
  "name": "@takazudo/zudo-sg",
  "version": "0.5.4",
  "type": "module",
  "description": "zudo-sg styleguide engine \u2014 story registry, catalog routes and preview machinery for zfb + zudo-doc hosts.",
  "license": "MIT",
  "author": "Takeshi Takatsudo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takazudo/zudo-sg.git",
    "directory": "packages/styleguide"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host-paths": {
      "types": "./dist/host-paths.d.ts",
      "default": "./dist/host-paths.js"
    },
    "./sg-routes": {
      "types": "./dist/sg-routes.d.ts",
      "default": "./dist/sg-routes.js"
    },
    "./stories": {
      "types": "./dist/stories/index.d.ts",
      "default": "./dist/stories/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    },
    "./token-dashboard": {
      "types": "./dist/token-dashboard/index.d.ts",
      "default": "./dist/token-dashboard/index.js"
    },
    "./cli": {
      "types": "./dist/cli/bin.d.ts",
      "default": "./dist/cli/bin.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./chrome": {
      "types": "./dist/chrome/index.d.ts",
      "default": "./dist/chrome/index.js"
    },
    "./chrome/panel-contract": {
      "types": "./dist/chrome/panel-contract.d.ts",
      "default": "./dist/chrome/panel-contract.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "default": "./dist/search/index.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "default": "./dist/preview/index.js"
    },
    "./preview/messages": {
      "types": "./dist/preview/messages.d.ts",
      "default": "./dist/preview/messages.js"
    },
    "./preview/external-runtime": {
      "types": "./dist/preview/external-runtime.d.ts",
      "default": "./dist/preview/external-runtime.js"
    },
    "./preview/runtime": {
      "types": "./dist/preview/runtime-controller.d.ts",
      "default": "./dist/preview/runtime-controller.js"
    },
    "./registry/external-catalog": {
      "types": "./dist/registry/external-catalog.d.ts",
      "default": "./dist/registry/external-catalog.js"
    },
    "./registry/external-catalog-node": {
      "types": "./dist/registry/external-catalog-node.d.ts",
      "default": "./dist/registry/external-catalog-node.js"
    },
    "./code-panel": {
      "types": "./dist/code-panel/index.d.ts",
      "default": "./dist/code-panel/index.js"
    },
    "./token-tweak": {
      "types": "./dist/token-tweak/index.d.ts",
      "default": "./dist/token-tweak/index.js"
    },
    "./token-tweak/preview-token-panel-bootstrap": {
      "types": "./dist/token-tweak/preview-token-panel-bootstrap.d.ts",
      "default": "./dist/token-tweak/preview-token-panel-bootstrap.js"
    },
    "./token-tweak/preview-tokens-button": {
      "types": "./dist/token-tweak/preview-tokens-button.d.ts",
      "default": "./dist/token-tweak/preview-tokens-button.js"
    },
    "./plugins/zdtp-apply-proxy": {
      "types": "./dist/plugins/zdtp-apply-proxy.d.ts",
      "default": "./dist/plugins/zdtp-apply-proxy.js"
    },
    "./preview-css": {
      "types": "./dist/preview-css/index.d.ts",
      "default": "./dist/preview-css/index.js"
    },
    "./sg-context": {
      "types": "./dist/sg-context.d.ts",
      "default": "./dist/sg-context.js"
    },
    "./plugins/routes": {
      "types": "./dist/plugins/routes.d.ts",
      "default": "./dist/plugins/routes.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./islands": {
      "types": "./dist/islands.d.ts",
      "default": "./dist/islands.js"
    },
    "./routes-src/*": "./routes-src/*",
    "./virtual-modules.d.ts": "./virtual-modules.d.ts",
    "./plugins/preview-css": {
      "types": "./dist/plugins/preview-css.d.ts",
      "default": "./dist/plugins/preview-css.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json",
    "./wind.json": "./dist/wind.json"
  },
  "bin": {
    "zudo-sg": "./bin/zudo-sg.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "!dist/.build-stamp",
    "bin",
    "routes-src",
    "virtual-modules.d.ts",
    "styles.css",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "check:no-host-alias": "node scripts/check-no-host-alias.mjs",
    "check:chrome-tokens": "node scripts/check-chrome-tokens.mjs",
    "check:package-shape": "node scripts/check-package-shape.mjs",
    "check:routes-src": "node scripts/check-routes-src.mjs",
    "check:virtual-modules": "node scripts/check-virtual-modules.mjs",
    "check": "pnpm run check:no-host-alias && pnpm run check:chrome-tokens && pnpm run typecheck && pnpm run build && pnpm run check:package-shape && pnpm run check:routes-src && pnpm run check:virtual-modules && pnpm run check:package-wind-manifest && pnpm run test",
    "check:package-wind-manifest": "node scripts/check-package-wind-manifest.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "postcss": "^8.5.28",
    "preact": "^10.29.1"
  },
  "peerDependencies": {
    "@takazudo/zfb": "^4.5.2",
    "@takazudo/zdtp": "^0.8.6",
    "@takazudo/zudo-doc": "^6.2.0"
  },
  "devDependencies": {
    "@takazudo/zdtp": "0.8.6",
    "@takazudo/zfb": "4.5.2",
    "@takazudo/zudo-doc": "6.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.5",
    "culori": "^4.0.2",
    "happy-dom": "20.14.6",
    "tsup": "^8.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "7.3.5",
    "vitest": "4.1.11"
  }
}
