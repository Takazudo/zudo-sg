{
  "name": "create-zudo-sg",
  "version": "0.2.4",
  "description": "Create a new zudo-sg styleguide project",
  "license": "MIT",
  "author": "Takeshi Takatsudo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takazudo/zudo-sg.git",
    "directory": "packages/create-zudo-sg"
  },
  "bugs": {
    "url": "https://github.com/Takazudo/zudo-sg/issues"
  },
  "keywords": [
    "create",
    "scaffold",
    "styleguide",
    "zudo-sg",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "create-zudo-sg": "bin/create-zudo-sg.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "!dist/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "7.3.5",
    "vitest": "4.1.11"
  }
}
