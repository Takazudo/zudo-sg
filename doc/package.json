{
  "name": "@zudo-sg/doc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "zfb dev",
    "build": "zfb build --strict-plain-css-imports",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:images": "zudo-doc check images",
    "check:html": "html-validate \"dist/**/*.html\"",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh",
    "setup:doc-skill-silent": "bash scripts/setup-doc-skill.sh --silent",
    "setup:doc-skill:claude": "bash scripts/setup-doc-skill.sh --target claude",
    "setup:doc-skill:codex": "bash scripts/setup-doc-skill.sh --target codex",
    "setup:doc-skill:both": "bash scripts/setup-doc-skill.sh --target both"
  },
  "dependencies": {
    "@takazudo/zfb": "4.5.3",
    "@takazudo/zfb-runtime": "4.5.3",
    "@takazudo/zfb-md-wasm": "4.5.3",
    "@takazudo/zudo-doc": "7.0.0",
    "zod": "^4.6.5",
    "katex": "^0.19.0",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@types/node": "^22.20.5",
    "html-validate": "^11.16.2"
  }
}
