{
  "name": "@zudo-sg/doc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "run-parallel dev:zfb dev:sources",
    "dev:zfb": "zfb dev",
    "dev:sources": "zudo-doc sources watch",
    "dev:zfb:network": "zfb dev --host 0.0.0.0",
    "dev:network": "run-parallel dev:zfb:network dev:sources",
    "build": "zfb build --strict-plain-css-imports",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:images": "zudo-doc check images",
    "check:html": "html-validate \"dist/**/*.html\"",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh",
    "setup:doc-skill-silent": "bash scripts/setup-doc-skill.sh --silent",
    "setup:doc-skill:claude": "bash scripts/setup-doc-skill.sh --target claude",
    "setup:doc-skill:codex": "bash scripts/setup-doc-skill.sh --target codex",
    "setup:doc-skill:both": "bash scripts/setup-doc-skill.sh --target both"
  },
  "dependencies": {
    "@takazudo/zfb": "7.2.0",
    "@takazudo/zfb-runtime": "7.2.0",
    "@takazudo/zfb-md-wasm": "7.2.0",
    "@takazudo/zudo-doc": "14.0.0",
    "zod": "^4.6.7",
    "katex": "^0.19.1",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@types/node": "^24.19.2",
    "html-validate": "^11.21.0"
  }
}
